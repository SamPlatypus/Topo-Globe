{
  "name": "topo-globe",
  "version": "0.1.0",
  "private": true,
  "description": "Offline 3D topographic maps of Victoria for Android (Capacitor). No network calls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "region:encode": "tsx pipeline/encode_region.ts",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "fflate": "0.8.2",
    "geographiclib-geodesic": "2.2.0",
    "maplibre-gl": "6.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@mapbox/vector-tile": "3.0.0",
    "@types/node": "22.18.0",
    "pbf": "5.1.2",
    "topojson-client": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "world-atlas": "2.0.2"
  }
}
